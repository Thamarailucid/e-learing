NODE_ENV=production

APP_NAME=Novacodex
APP_ENVIRONMENT=production

# Server & Routing
BACKEND_URL=https://learning.novacodex.in
FRONTEND_URL=https://elearning.novacodex.in
API_PREFIX=/api/v1
PORT=5000

# PostgreSQL Production Database (Running on EC2 or AWS RDS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=novacodex_production
POSTGRES_USER=novacodex_admin
POSTGRES_PASSWORD=YOUR_STRONG_DB_PASSWORD
POSTGRES_SCHEMA=novacodex

# JWT Security Secrets (Generate using: openssl rand -base64 32)
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_123
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_STRONG_REFRESH_SECRET_KEY_456
JWT_REFRESH_EXPIRES_IN=7d

# Initial Super Admin Account
SUPER_ADMIN_EMAIL=admin@novacodex.in
SUPER_ADMIN_PASSWORD=Admin@Novacodex2026!

# File Storage Provider: 's3' or 'local'
FILE_STORAGE_PROVIDER=s3

# AWS S3 Storage Credentials & Endpoints
S3_BUCKET_NAME=novacodex-lms-media
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
# S3_ENDPOINT is optional; leave empty for standard AWS S3 or use for custom MinIO/Cloudflare R2:
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# Local Fallback Paths (if FILE_STORAGE_PROVIDER=local)
LOCAL_FILE_STORAGE_PATH=./storage
LOCAL_VIDEO_STORAGE_PATH=./storage/videos
LOCAL_DOCUMENT_STORAGE_PATH=./storage/documents
LOCAL_ASSIGNMENT_STORAGE_PATH=./storage/assignments
LOCAL_CERTIFICATE_STORAGE_PATH=./storage/certificates

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://elearning.novacodex.in,https://learning.novacodex.in

LOG_LEVEL=info
