NODE_ENV=production

APP_NAME=Novacodex
APP_ENVIRONMENT=production

BACKEND_URL=https://api.novacodex.in
FRONTEND_URL=https://app.novacodex.in

API_PREFIX=/api/v1

PORT=5000

POSTGRES_HOST=YOUR_PRODUCTION_DB_HOST
POSTGRES_PORT=5432
POSTGRES_DATABASE=novacodex_production
POSTGRES_USER=YOUR_PRODUCTION_DB_USER
POSTGRES_PASSWORD=YOUR_PRODUCTION_DB_PASSWORD
POSTGRES_SCHEMA=novacodex

JWT_ACCESS_SECRET=YOUR_PRODUCTION_SECRET
JWT_ACCESS_EXPIRES_IN=1d

JWT_REFRESH_SECRET=YOUR_PRODUCTION_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

SUPER_ADMIN_EMAIL=admin@novacodex.in
SUPER_ADMIN_PASSWORD=SET_FROM_DEPLOYMENT_SECRET

FILE_STORAGE_PROVIDER=s3

LOCAL_FILE_STORAGE_PATH=
LOCAL_VIDEO_STORAGE_PATH=
LOCAL_DOCUMENT_STORAGE_PATH=
LOCAL_ASSIGNMENT_STORAGE_PATH=
LOCAL_CERTIFICATE_STORAGE_PATH=

S3_BUCKET_NAME=YOUR_Novacodex_BUCKET
S3_REGION=YOUR_AWS_REGION
S3_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
S3_ENDPOINT=

REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

CORS_ALLOWED_ORIGINS=https://app.novacodex.in

LOG_LEVEL=info
